{
  "name": "birrwise",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "frontend:install": "npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "backend:dev": "cd backend && PORT=8080 DATABASE_PATH=birrwise.db GIN_MODE=debug go run ./cmd/server",
    "backend:build": "cd backend && go build ./cmd/server",
    "dev": "npm run frontend:dev"
  }
}
